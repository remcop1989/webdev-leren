<!DOCTYPE html>
<html>
    <head>
        <style>

            body {
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

            button {
                background-color: lightblue;
                width: 75px;
                height: 50px;
            }

            .buttons {
                display: flex;
                justify-content: space-between;
                align-items: stretch;
            }

            .teller {
                width: 250px;
            }

            .display {
                border: 2px black solid;
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 50px;
                font-size: 30px;
            }
        </style>
    </head>
    <body>
        <div class="teller">
            <h1>Teller project</h1>
            <p class="display">0</p>
            
            <div class="buttons">
                <button class="minus">-</button>
                <button class="plus">+</button>
                <button class="reset">Reset</button>
            </div>
        </div>
        <script>
            const minusOne = document.querySelector(".minus");
            const plusOne = document.querySelector(".plus");
            const resetButton = document.querySelector(".reset");
            const displayNumber = document.querySelector(".display");

            plusOne.addEventListener('click', function() {
                displayNumber.textContent = Number(displayNumber.textContent) + 1;
            })

            minusOne.addEventListener('click', function() {
                displayNumber.textContent = Number(displayNumber.textContent) - 1;
            })

            resetButton.addEventListener('click', function() {
                displayNumber.textContent = 0;
            })
        </script>
    </body>
</html>