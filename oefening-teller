<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width" />
        <title>Teller oefening</title>

        <style>
            body {
                height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

            button {
                background-color: lightblue;
                width: 75px;
                height: 50px;
            }

            .buttons {
                display: flex;
                justify-content: space-between;
            }

            .teller {
                width: 250px;
            }

            .display {
                border: 2px solid black;
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 50px;
                font-size: 30px;
            }
        </style>
    </head>
    <body>
        <div class="teller">
            <h1>Teller project</h1>
            <p class="display">0</p>
            
            <div class="buttons">
                <button class="minus">-</button>
                <button class="plus">+</button>
                <button class="reset">Reset</button>
            </div>

        </div>
        <script>
            //vereenvoudigen naar gezamenlijke functie zoals oefening 3
            //maak een js variabele om waarde van teller te onthouden ipv via DOM
            const minusButton = document.querySelector(".minus");
            const plusButton = document.querySelector(".plus");
            const resetButton = document.querySelector(".reset");
            const displayNumber = document.querySelector(".display");

            plusButton.addEventListener('click', function() {
                displayNumber.textContent = Number(displayNumber.textContent) + 1;
            })

            minusButton.addEventListener('click', function() {
                displayNumber.textContent = Number(displayNumber.textContent) - 1;
            })

            resetButton.addEventListener('click', function() {
                displayNumber.textContent = 0;
            })
        </script>
    </body>
</html>