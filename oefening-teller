<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width" />
        <title>Teller oefening</title>

        <style>
            body {
                height: 100vh;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

            button {
                background-color: lightblue;
                width: 75px;
                height: 50px;
            }

            .buttons {
                display: flex;
                justify-content: space-between;
                padding: 5px;
            }

            .teller {
                width: 250px;
            }

            .display {
                border: 2px solid black;
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 50px;
                font-size: 30px;
            }
        </style>
    </head>
    <body>
        <div class="teller">
            <h1>Teller project</h1>
            <p class="display">0</p>
            
            <div class="buttons">
                <button class="minus">-</button>
                <button class="plus">+</button>
                <button class="reset">Reset</button>
            </div>

            <div class="buttons">
                <input type="text" class="multiplyValue">
                <button class="multiply">x</button>
            </div>
        </div>

        <script>
            const minusButton = document.querySelector(".minus");
            const plusButton = document.querySelector(".plus");
            const resetButton = document.querySelector(".reset");
            const multiplyButton = document.querySelector(".multiply")
            const displayNumber = document.querySelector(".display");
            let tellerWaarde = 0;

            plusButton.addEventListener('click', function() {
                displayBijwerken(plusOne);
            })

            minusButton.addEventListener('click', function() {;
                displayBijwerken(minusOne);
            })

            resetButton.addEventListener('click', function() {
                displayBijwerken(reset);
            })

            multiplyButton.addEventListener('click', function() {
                displayBijwerken(timesOne);
            })

            function displayBijwerken(rekenWaarde) {
                tellerWaarde = rekenWaarde(tellerWaarde);
                displayNumber.textContent = tellerWaarde;
            }

            function plusOne(beginWaarde) {
                return beginWaarde + 1;
            }

            function minusOne(beginWaarde) {
                return beginWaarde - 1;
            }

            function reset() {
                return tellerWaarde = 0;
            }

            function timesOne() {
                const multiply = document.querySelector(".multiplyValue").value;
/*                 if (multiply === "") {
                    return tellerWaarde;
                } else {
                    return tellerWaarde * multiply;
                } */

                return multiply === "" ? tellerWaarde : tellerWaarde * multiply;
            }
            

        </script>
    </body>
</html>